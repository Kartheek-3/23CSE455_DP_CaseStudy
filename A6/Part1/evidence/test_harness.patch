@@ -0,0 +1,26 @@
+import "reflect-metadata";
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { CancelBookingInputUseCase } from "../src/application/use_cases/User/CancelBooking";
+import { AdminChangeDriverStatus } from "../src/application/use_cases/Admin/AdminChangeDriverStatus";
+import { BookingStatus } from "../src/domain/models/Booking";
+import { FakeBookingRepo, FakeDriverRepo, FakeNotifier, makeBooking, makeDriver } from "./helpers/fakes";
+
+// These tests document defects of the public baseline that motivate CH01 and CH02.
+// They pass on the baseline; CH01/CH02 replace them with tests of the corrected behaviour.
+
+test("DEFECT (baseline): a COMPLETED trip can still be cancelled", async () => {
+  const bookings = new FakeBookingRepo();
+  const b = bookings.seed(makeBooking({ status: BookingStatus.COMPLETED }));
+  const useCase = new CancelBookingInputUseCase(new FakeNotifier() as any, bookings as any);
+  await useCase.execute({ bookingId: String(b._id), status: BookingStatus.CANCELLED, reason: "late" });
+  assert.equal((await bookings.findBookingById(String(b._id)))?.status, BookingStatus.CANCELLED);
+});
+
+test("DEFECT (baseline): an admin can move a rejected driver straight to approved", async () => {
+  const drivers = new FakeDriverRepo();
+  const d = drivers.seed(makeDriver({ status: "rejected" }));
+  const useCase = new AdminChangeDriverStatus(drivers as any, new FakeNotifier() as any);
+  const res = await useCase.execute(String(d._id), "approved");
+  assert.equal(res?.status, "approved");
+});
diff --git a/tests/booking.test.ts b/tests/booking.test.ts
new file mode 100644
index 0000000..f5246ca
--- /dev/null
+++ b/tests/booking.test.ts
@@ -0,0 +1,81 @@
+import "reflect-metadata";
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { Types } from "mongoose";
+import { BookDriver } from "../src/application/use_cases/User/BookDriver";
+import { CancelBookingInputUseCase } from "../src/application/use_cases/User/CancelBooking";
+import { UpdateBookingStatus } from "../src/application/use_cases/Driver/UpdateBookingstatus";
+import { FareCalculatorService } from "../src/infrastructure/services/FareCalculatorService";
+import { BookingStatus, BookingType } from "../src/domain/models/Booking";
+import { FakeBookingRepo, FakeDriverRepo, FakeNotifier, FakeDistance, makeBooking, id } from "./helpers/fakes";
+
+const future = new Date(Date.now() + 5 * 24 * 3600 * 1000);
+
+test("BookDriver broadcasts only to drivers within 20 km road distance and saves a PENDING trip", async () => {
+  const bookings = new FakeBookingRepo();
+  const drivers = new FakeDriverRepo();
+  const [near, far] = [id(), id()];
+  drivers.nearby = [
+    { _id: near, latitude: 10.01, longitude: 76.3 },
+    { _id: far, latitude: 10.2, longitude: 76.3 },
+  ];
+  const notifier = new FakeNotifier();
+  const useCase = new BookDriver(bookings as any, drivers as any, new FareCalculatorService(), notifier as any,
+    new FakeDistance({ [near]: 4, [far]: 25 }) as any);
+
+  const saved = await useCase.execute({
+    userId: id(), fromLocation: "Kochi", toLocation: "Aluva", startDate: future,
+    estimatedKm: 30, bookingType: BookingType.ONE_WAY, fromLat: 10, fromLng: 76.3,
+  });
+
+  assert.equal(saved.status, BookingStatus.PENDING);
+  assert.equal(saved.estimatedFare, 450);
+  assert.deepEqual(notifier.calls.map((c) => [c[0], c[1]]), [["broadcastBookingNotification", near]]);
+});
+
+test("BookDriver refuses the request when no driver is within 20 km by road", async () => {
+  const drivers = new FakeDriverRepo();
+  const far = id();
+  drivers.nearby = [{ _id: far, latitude: 10.2, longitude: 76.3 }];
+  const useCase = new BookDriver(new FakeBookingRepo() as any, drivers as any, new FareCalculatorService(),
+    new FakeNotifier() as any, new FakeDistance({ [far]: 25 }) as any);
+  await assert.rejects(useCase.execute({
+    userId: id(), fromLocation: "Kochi", startDate: future, estimatedKm: 30,
+    bookingType: BookingType.ONE_WAY, fromLat: 10, fromLng: 76.3,
+  }));
+});
+
+test("rider cancelling a PENDING trip sets CANCELLED and stores the reason", async () => {
+  const bookings = new FakeBookingRepo();
+  const b = bookings.seed(makeBooking({ status: BookingStatus.PENDING }));
+  const useCase = new CancelBookingInputUseCase(new FakeNotifier() as any, bookings as any);
+  await useCase.execute({ bookingId: String(b._id), status: BookingStatus.CANCELLED, reason: "plans changed" });
+  const after = await bookings.findBookingById(String(b._id));
+  assert.equal(after?.status, BookingStatus.CANCELLED);
+  assert.equal(after?.reason, "plans changed");
+});
+
+test("rider cancelling a CONFIRMED trip notifies the assigned driver", async () => {
+  const bookings = new FakeBookingRepo();
+  const driverId = new Types.ObjectId();
+  const b = bookings.seed(makeBooking({ status: BookingStatus.CONFIRMED, driverId, startDate: future }));
+  const notifier = new FakeNotifier();
+  const useCase = new CancelBookingInputUseCase(notifier as any, bookings as any);
+  await useCase.execute({ bookingId: String(b._id), status: BookingStatus.CANCELLED, reason: "x" });
+  assert.deepEqual(notifier.calls.map((c) => [c[0], c[1]]), [["cancelBookingNotification", driverId.toString()]]);
+});
+
+test("driver completing a trip stores finalFare = estimatedFare + finalKm * 10", async () => {
+  const bookings = new FakeBookingRepo();
+  const b = bookings.seed(makeBooking({ status: BookingStatus.CONFIRMED, driverId: new Types.ObjectId() }));
+  const useCase = new UpdateBookingStatus(bookings as any, new FakeNotifier() as any);
+  await useCase.execute({ bookingId: String(b._id), status: BookingStatus.COMPLETED, finalKm: 12 });
+  assert.equal((await bookings.findBookingById(String(b._id)))?.finalFare, 570);
+});
+
+test("completing a trip without finalKm is rejected", async () => {
+  const bookings = new FakeBookingRepo();
+  const b = bookings.seed(makeBooking({ status: BookingStatus.CONFIRMED }));
+  const useCase = new UpdateBookingStatus(bookings as any, new FakeNotifier() as any);
+  await assert.rejects(useCase.execute({ bookingId: String(b._id), status: BookingStatus.COMPLETED }));
+});
diff --git a/tests/fare.test.ts b/tests/fare.test.ts
new file mode 100644
index 0000000..9399de0
--- /dev/null
+++ b/tests/fare.test.ts
@@ -0,0 +1,34 @@
+import "reflect-metadata";
+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { FareCalculatorService } from "../src/infrastructure/services/FareCalculatorService";
+import { BookingType } from "../src/domain/models/Booking";
+
+// Characterization of the baseline fare rules. These must keep passing after CH03.
+const calc = new FareCalculatorService();
+const start = new Date("2026-12-01T06:30:00.000Z"); // 12:00 IST - outside peak hours
+
+test("ONE_WAY below the minimum is charged Rs 450", () => {
+  assert.equal(calc.calculate({ bookingType: BookingType.ONE_WAY, estimatedKm: 30, startDate: start }), 450);
+});
+
+test("ONE_WAY is Rs 10 per km above the minimum", () => {
+  assert.equal(calc.calculate({ bookingType: BookingType.ONE_WAY, estimatedKm: 60, startDate: start }), 600);
+});
+
+test("ONE_WAY without km is rejected", () => {
+  assert.throws(() => calc.calculate({ bookingType: BookingType.ONE_WAY, startDate: start }));
+});
+
+test("ROUND_TRIP (range of dates) is Rs 1000 per calendar day, inclusive", () => {
+  const end = new Date("2026-12-03T06:30:00.000Z");
+  assert.equal(calc.calculate({ bookingType: BookingType.ROUND_TRIP, startDate: start, endDate: end }), 3000);
+});
+
+test("ROUND_TRIP without end date is rejected", () => {
+  assert.throws(() => calc.calculate({ bookingType: BookingType.ROUND_TRIP, startDate: start }));
+});
+
+test("unknown booking type is rejected", () => {
+  assert.throws(() => calc.calculate({ bookingType: "SHUTTLE" as BookingType, estimatedKm: 10, startDate: start }));
+});
diff --git a/tests/helpers/fakes.ts b/tests/helpers/fakes.ts
new file mode 100644
index 0000000..2c58d8f
--- /dev/null
+++ b/tests/helpers/fakes.ts
@@ -0,0 +1,142 @@
+// In-memory test doubles so the use cases run without MongoDB, Redis, Stripe or Google Maps.
+import { Types } from "mongoose";
+import { Booking, BookingStatus, BookingType } from "../../src/domain/models/Booking";
+import { Driver } from "../../src/domain/models/Driver";
+
+export const id = () => new Types.ObjectId().toString();
+
+export function makeBooking(overrides: Partial<Booking> = {}): Booking {
+  return {
+    _id: id(),
+    userId: new Types.ObjectId(),
+    fromLocation: "Kochi",
+    toLocation: "Aluva",
+    startDate: new Date("2026-12-01T04:30:00.000Z"),
+    estimatedKm: 30,
+    estimatedFare: 450,
+    bookingType: BookingType.ONE_WAY,
+    status: BookingStatus.PENDING,
+    paymentMode: "stripe",
+    fromLat: 10.0,
+    fromLng: 76.3,
+    ...overrides,
+  };
+}
+
+export function makeDriver(overrides: Partial<Driver> = {}): Driver {
+  return {
+    _id: id(),
+    name: "Test Driver",
+    email: "driver@example.test",
+    mobile: "9000000000",
+    password: "hashed",
+    profileImage: "",
+    location: { type: "Point", coordinates: [76.3, 10.0] },
+    place: "Kochi",
+    aadhaarNumber: "000000000000",
+    licenseNumber: "KL0000000000",
+    aadhaarImage: "",
+    licenseImage: "",
+    status: "approved",
+    isBlock: false,
+    role: "driver",
+    onlineStatus: "online",
+    lastSeen: new Date(),
+    averageRating: 0,
+    totalRatings: 0,
+    totalRatingPoints: 0,
+    ...overrides,
+  } as Driver;
+}
+
+export class FakeBookingRepo {
+  bookings = new Map<string, Booking>();
+  updates: { id: string; changes: Partial<Booking> }[] = [];
+
+  seed(b: Booking) {
+    this.bookings.set(String(b._id), { ...b });
+    return b;
+  }
+  async createBooking(b: Booking) {
+    const saved = { ...b, _id: id() };
+    this.bookings.set(String(saved._id), saved);
+    return saved;
+  }
+  async findBookingById(bookingId: string) {
+    return this.bookings.get(bookingId) ?? null;
+  }
+  async updateBooking(bookingId: string, changes: Partial<Booking>) {
+    this.updates.push({ id: bookingId, changes });
+    const cur = this.bookings.get(bookingId);
+    if (!cur) return null;
+    const next = { ...cur, ...changes };
+    this.bookings.set(bookingId, next);
+    return next;
+  }
+  async checkDriverAvailability() {
+    return true;
+  }
+  // Used from CH01 onwards (AcceptBooking no longer queries the Mongoose model directly).
+  async acceptPendingBooking(bookingId: string, driverId: string) {
+    const cur = this.bookings.get(bookingId);
+    if (!cur || cur.status !== BookingStatus.PENDING) return null;
+    const next = { ...cur, status: BookingStatus.CONFIRMED, driverId: new Types.ObjectId(driverId) };
+    this.bookings.set(bookingId, next);
+    return next;
+  }
+}
+
+export class FakeDriverRepo {
+  drivers = new Map<string, Driver>();
+  nearby: { _id: string; latitude: number; longitude: number }[] = [];
+  statusCalls: { driverId: string; status: string; reason?: string }[] = [];
+
+  seed(d: Driver) {
+    this.drivers.set(String(d._id), { ...d });
+    return d;
+  }
+  async findDriverById(driverId: string) {
+    return this.drivers.get(driverId) ?? null;
+  }
+  async findNearbyDriversWithinRadius() {
+    return this.nearby;
+  }
+  async updateStatus(driverId: string, status: any, reason?: string) {
+    this.statusCalls.push({ driverId, status, reason });
+    const cur = this.drivers.get(driverId);
+    if (!cur) return null;
+    const next = { ...cur, status, reason } as Driver;
+    this.drivers.set(driverId, next);
+    return next;
+  }
+}
+
+/** Records every notification call: [methodName, recipientId, payload]. */
+export class FakeNotifier {
+  calls: [string, string | undefined, any][] = [];
+  private rec(name: string) {
+    return async (who?: any, data?: any) => {
+      this.calls.push([name, Array.isArray(who) ? who.join(",") : who, data]);
+    };
+  }
+  sendBookingNotification = this.rec("sendBookingNotification");
+  broadcastBookingNotification = this.rec("broadcastBookingNotification");
+  cancelBookingNotification = this.rec("cancelBookingNotification");
+  paymentNotification = this.rec("paymentNotification");
+  bookingAssignedNotification = this.rec("bookingAssignedNotification") as any;
+  sendBookingConfirmation = this.rec("sendBookingConfirmation");
+  rejectBookingNotification = this.rec("rejectBookingNotification");
+  adminChangeDriverStatusNotification = this.rec("adminChangeDriverStatusNotification");
+  driverCancelledBookingNotification = this.rec("driverCancelledBookingNotification");
+  names() {
+    return this.calls.map((c) => c[0]);
+  }
+}
+
+/** Road distances keyed by driver id. */
+export class FakeDistance {
+  constructor(public km: Record<string, number> = {}) {}
+  async getDistances() {
+    return this.km;
+  }
+}

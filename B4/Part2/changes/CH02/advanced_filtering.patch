diff --git a/app/Domain/Search/MaxMonthlyRentSpecification.php b/app/Domain/Search/MaxMonthlyRentSpecification.php
new file mode 100644
index 0000000..07a72c6
--- /dev/null
+++ b/app/Domain/Search/MaxMonthlyRentSpecification.php
@@ -0,0 +1,16 @@
+<?php
+
+namespace App\Domain\Search;
+
+final readonly class MaxMonthlyRentSpecification implements PropertySpecification
+{
+    public function __construct(private float $maximum)
+    {
+    }
+
+    public function isSatisfiedBy(array $property): bool
+    {
+        return isset($property['monthly_rent'])
+            && (float) $property['monthly_rent'] <= $this->maximum;
+    }
+}
diff --git a/app/Domain/Search/PropertyFilterService.php b/app/Domain/Search/PropertyFilterService.php
new file mode 100644
index 0000000..7982085
--- /dev/null
+++ b/app/Domain/Search/PropertyFilterService.php
@@ -0,0 +1,18 @@
+<?php
+
+namespace App\Domain\Search;
+
+final class PropertyFilterService
+{
+    /**
+     * @param list<array<string, mixed>> $properties
+     * @return list<array<string, mixed>>
+     */
+    public function matching(array $properties, PropertySpecification $specification): array
+    {
+        return array_values(array_filter(
+            $properties,
+            fn (array $property): bool => $specification->isSatisfiedBy($property),
+        ));
+    }
+}
diff --git a/app/Domain/Search/PropertySpecification.php b/app/Domain/Search/PropertySpecification.php
new file mode 100644
index 0000000..6c3da62
--- /dev/null
+++ b/app/Domain/Search/PropertySpecification.php
@@ -0,0 +1,9 @@
+<?php
+
+namespace App\Domain\Search;
+
+interface PropertySpecification
+{
+    /** @param array<string, mixed> $property */
+    public function isSatisfiedBy(array $property): bool;
+}
diff --git a/app/Domain/Search/RentRangeSpecification.php b/app/Domain/Search/RentRangeSpecification.php
new file mode 100644
index 0000000..aed5467
--- /dev/null
+++ b/app/Domain/Search/RentRangeSpecification.php
@@ -0,0 +1,21 @@
+<?php
+
+namespace App\Domain\Search;
+
+use InvalidArgumentException;
+
+final readonly class RentRangeSpecification implements PropertySpecification
+{
+    public function __construct(private float $minimum, private float $maximum)
+    {
+        if ($minimum > $maximum) {
+            throw new InvalidArgumentException('Minimum rent cannot exceed maximum rent.');
+        }
+    }
+
+    public function isSatisfiedBy(array $property): bool
+    {
+        $rent = (float) ($property['monthly_rent'] ?? -1);
+        return $rent >= $this->minimum && $rent <= $this->maximum;
+    }
+}
diff --git a/app/Domain/Search/StatusSpecification.php b/app/Domain/Search/StatusSpecification.php
new file mode 100644
index 0000000..c46c03a
--- /dev/null
+++ b/app/Domain/Search/StatusSpecification.php
@@ -0,0 +1,15 @@
+<?php
+
+namespace App\Domain\Search;
+
+final readonly class StatusSpecification implements PropertySpecification
+{
+    public function __construct(private string $status)
+    {
+    }
+
+    public function isSatisfiedBy(array $property): bool
+    {
+        return ($property['status'] ?? null) === $this->status;
+    }
+}

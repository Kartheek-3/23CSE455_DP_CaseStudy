 namespace App\Http\Controllers;
 
+use App\Domain\Search\AddressContainsSpecification;
+use App\Domain\Search\AndSpecification;
+use App\Domain\Search\MaxMonthlyRentSpecification;
+use App\Domain\Search\PropertyFilterService;
+use App\Domain\Search\StatusSpecification;
 use App\Models\Property;
 use App\Models\Owner;
 use App\Models\Tenant;
 use App\Http\Requests\StorePropertyRequest;
 use App\Http\Requests\UpdatePropertyRequest;
+use Illuminate\Http\Request;
 
 class PropertyController extends Controller
 {
-    public function index()
+    public function index(Request $request, PropertyFilterService $filters)
     {
-        $properties = Property::with(['owner', 'tenant'])
+        $query = Property::with(['owner', 'tenant']);
+        $specifications = [];
+
+        if ($request->filled('address')) {
+            $specifications[] = new AddressContainsSpecification($request->string('address')->toString());
+        }
+        if ($request->filled('max_rent')) {
+            $specifications[] = new MaxMonthlyRentSpecification((float) $request->input('max_rent'));
+        }
+        if ($request->filled('status')) {
+            $specifications[] = new StatusSpecification($request->string('status')->toString());
+        }
+
+        if ($specifications !== []) {
+            $candidates = (clone $query)->get()->map->toArray()->all();
+            $matching = $filters->matching($candidates, new AndSpecification($specifications));
+            $query->whereIn('id', array_column($matching, 'id'));
+        }
+
+        $properties = $query
             ->latest()
-            ->paginate(10);
+            ->paginate(10)
+            ->withQueryString();
 
         return view('properties.index', compact('properties'));
     }

diff --git a/app/Domain/Search/AddressContainsSpecification.php b/app/Domain/Search/AddressContainsSpecification.php
new file mode 100644
index 0000000..a64d6b1
--- /dev/null
+++ b/app/Domain/Search/AddressContainsSpecification.php
@@ -0,0 +1,18 @@
+<?php
+
+namespace App\Domain\Search;
+
+final readonly class AddressContainsSpecification implements PropertySpecification
+{
+    public function __construct(private string $fragment)
+    {
+    }
+
+    public function isSatisfiedBy(array $property): bool
+    {
+        return str_contains(
+            strtolower((string) ($property['address'] ?? '')),
+            strtolower($this->fragment),
+        );
+    }
+}
diff --git a/app/Domain/Search/AmenitySpecification.php b/app/Domain/Search/AmenitySpecification.php
new file mode 100644
index 0000000..ebd5ef0
--- /dev/null
+++ b/app/Domain/Search/AmenitySpecification.php
@@ -0,0 +1,15 @@
+<?php
+
+namespace App\Domain\Search;
+
+final readonly class AmenitySpecification implements PropertySpecification
+{
+    public function __construct(private string $amenity)
+    {
+    }
+
+    public function isSatisfiedBy(array $property): bool
+    {
+        return in_array(strtolower($this->amenity), array_map('strtolower', $property['amenities'] ?? []), true);
+    }
+}
diff --git a/app/Domain/Search/AndSpecification.php b/app/Domain/Search/AndSpecification.php
new file mode 100644
index 0000000..48a5be6
--- /dev/null
+++ b/app/Domain/Search/AndSpecification.php
@@ -0,0 +1,22 @@
+<?php
+
+namespace App\Domain\Search;
+
+final readonly class AndSpecification implements PropertySpecification
+{
+    /** @param list<PropertySpecification> $specifications */
+    public function __construct(private array $specifications)
+    {
+    }
+
+    public function isSatisfiedBy(array $property): bool
+    {
+        foreach ($this->specifications as $specification) {
+            if (! $specification->isSatisfiedBy($property)) {
+                return false;
+            }
+        }
+
+        return true;
+    }
+}
diff --git a/app/Domain/Search/AvailableSpecification.php b/app/Domain/Search/AvailableSpecification.php
new file mode 100644
index 0000000..b0da327
--- /dev/null
+++ b/app/Domain/Search/AvailableSpecification.php
@@ -0,0 +1,11 @@
+<?php
+
+namespace App\Domain\Search;
+
+final class AvailableSpecification implements PropertySpecification
+{
+    public function isSatisfiedBy(array $property): bool
+    {
+        return ($property['available'] ?? false) === true;
+    }
+}

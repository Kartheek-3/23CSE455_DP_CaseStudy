@@ -0,0 +1,22 @@
+<?php
+
+namespace App\Domain\Pricing;
+
+use InvalidArgumentException;
+
+final class DynamicPricing implements PricingStrategy
+{
+    public function quote(float $baseMonthlyRent, PricingContext $context): float
+    {
+        if ($baseMonthlyRent <= 0) {
+            throw new InvalidArgumentException('Base monthly rent must be positive.');
+        }
+
+        $multiplier = 1.0;
+        $multiplier += in_array($context->month, [4, 5, 12], true) ? 0.20 : 0.0;
+        $multiplier += $context->occupancyRate >= 0.80 ? 0.10 : 0.0;
+        $multiplier -= $context->leaseMonths >= 12 ? 0.05 : 0.0;
+
+        return round($baseMonthlyRent * $multiplier, 2);
+    }
+}
diff --git a/app/Domain/Pricing/PricingContext.php b/app/Domain/Pricing/PricingContext.php
new file mode 100644
index 0000000..5a9f13f
--- /dev/null
+++ b/app/Domain/Pricing/PricingContext.php
@@ -0,0 +1,26 @@
+<?php
+
+namespace App\Domain\Pricing;
+
+use InvalidArgumentException;
+
+final readonly class PricingContext
+{
+    public function __construct(
+        public int $month,
+        public float $occupancyRate,
+        public int $leaseMonths,
+    ) {
+        if ($month < 1 || $month > 12) {
+            throw new InvalidArgumentException('Month must be between 1 and 12.');
+        }
+
+        if ($occupancyRate < 0 || $occupancyRate > 1) {
+            throw new InvalidArgumentException('Occupancy rate must be between 0 and 1.');
+        }
+
+        if ($leaseMonths < 1) {
+            throw new InvalidArgumentException('Lease months must be positive.');
+        }
+    }
+}
diff --git a/app/Domain/Pricing/PricingService.php b/app/Domain/Pricing/PricingService.php
new file mode 100644
index 0000000..d9e2c95
--- /dev/null
+++ b/app/Domain/Pricing/PricingService.php
@@ -0,0 +1,15 @@
+<?php
+
+namespace App\Domain\Pricing;
+
+final class PricingService
+{
+    public function __construct(private PricingStrategy $strategy)
+    {
+    }
+
+    public function quote(float $baseMonthlyRent, PricingContext $context): float
+    {
+        return $this->strategy->quote($baseMonthlyRent, $context);
+    }
+}

%% CH02 - "Irrigation Decision Strategy" (Strategy) - status: newly_introduced
%% Code: Part2/changes/Change2/code/mycodo/utils/irrigation_strategies.py and mycodo/functions/bang_bang.py
classDiagram
    class bang_bang_CustomModule["bang_bang.CustomModule"]
    <<Context>> bang_bang_CustomModule
    bang_bang_CustomModule : +strategy
    bang_bang_CustomModule : +initialize()
    bang_bang_CustomModule : -_build_irrigation_strategy()
    bang_bang_CustomModule : +loop()
    bang_bang_CustomModule : -_read_rain_indicator()
    bang_bang_CustomModule : -_apply_decision(decision)
    class IrrigationStrategy {
        <<abstract>>
        +decide(context)*
        +needs_rain_indicator()
    }
    class RaiseHysteresisStrategy {
        +decide(context)
    }
    class LowerHysteresisStrategy {
        +decide(context)
    }
    class TimeWindowStrategy {
        +windows
        +decide(context)
    }
    class RainSkipStrategy {
        +threshold
        +decide(context)
        +needs_rain_indicator()
    }
    class IrrigationRestriction {
        +inner
    }
    class IrrigationContext {
        <<dataclass>>
        +measurement
        +output_state
        +lower_threshold
        +upper_threshold
        +now
        +rain_indicator
    }
    class build_irrigation_strategy
    <<function>> build_irrigation_strategy
    IrrigationStrategy <|-- RaiseHysteresisStrategy
    IrrigationStrategy <|-- LowerHysteresisStrategy
    IrrigationStrategy <|-- IrrigationRestriction
    IrrigationRestriction <|-- TimeWindowStrategy
    IrrigationRestriction <|-- RainSkipStrategy
    bang_bang_CustomModule o-- IrrigationStrategy : strategy
    bang_bang_CustomModule ..> build_irrigation_strategy : _build_irrigation_strategy()
    bang_bang_CustomModule ..> IrrigationContext : creates in loop()
    IrrigationStrategy ..> IrrigationContext : decide(context)
    build_irrigation_strategy ..> IrrigationStrategy : creates

+    def _check_critically_dry(self, value):
+        """Raise a critically-dry alert below the configured critical level; clear it otherwise."""
+        if self.alert_critical_moisture and value < self.alert_critical_moisture:
+            self.alerts.raise_alert(SensorAlert(

diff --git a/backend/app/services/attendance_events.py b/backend/app/services/attendance_events.py
new file mode 100644
--- /dev/null
+++ b/backend/app/services/attendance_events.py
@@ -0,0 +1,170 @@
+from abc import ABC, abstractmethod
+from dataclasses import dataclass
+from datetime import datetime
+from typing import List, Optional
+
+from fastapi import BackgroundTasks
+from sqlalchemy.orm import Session
+
+from ..database import SessionLocal
+from ..models import Attendance, Class, Member, Notification, User
+from ..utils.notifications import send_email, send_sms
+
+ATTENDANCE_MARKED = "attendance_marked"
+CLASS_MISSED = "class_missed"
+STREAK_MILESTONE = "streak_milestone"
+
+STREAK_MILESTONES = {3, 7, 14, 30}
+
+
+@dataclass
+class AttendanceEvent:
+    type: str
+    member: Member
+    cls: Class
+    streak: Optional[int] = None
+
+    def subject(self) -> str:
+        if self.type == ATTENDANCE_MARKED:
+            return f"Checked in: {self.cls.name}"
+        if self.type == CLASS_MISSED:
+            return f"Missed class: {self.cls.name}"
+        return f"{self.streak}-day attendance streak!"
+
+    def member_message(self) -> str:
+        when = self.cls.start_time.strftime("%b %d at %I:%M %p")
+        if self.type == ATTENDANCE_MARKED:
+            return f"Your attendance for {self.cls.name} on {when} has been recorded."
+        if self.type == CLASS_MISSED:
+            return f"You were marked absent from {self.cls.name} on {when}. Book your next session to stay on track."
+        return f"Great work! You have attended classes {self.streak} days in a row."
+
+    def trainer_message(self) -> str:
+        name = self.member.user.full_name
+        if self.type == CLASS_MISSED:
+            return f"Your client {name} missed {self.cls.name} on {self.cls.start_time.strftime('%b %d at %I:%M %p')}."
+        return f"Your client {name} reached a {self.streak}-day attendance streak."
+
+
+class AttendanceObserver(ABC):
+    @abstractmethod
+    def update(self, event: AttendanceEvent, db: Session, background_tasks: BackgroundTasks) -> None:
+        ...
+
+
+def _record(db: Session, user: User, event: AttendanceEvent, channel: str, content: str, status: str = "sent") -> Notification:
+    notification = Notification(
+        user_id=user.id,
+        type=event.type,
+        channel=channel,
+        subject=event.subject(),
+        content=content,
+        status=status,
+        sent_at=datetime.utcnow() if status == "sent" else None,
+    )
+    db.add(notification)
+    db.flush()
+    return notification
+
+
+def _deliver(notification_id: int, sender, *args) -> None:
+    db = SessionLocal()
+    try:
+        notification = db.query(Notification).filter(Notification.id == notification_id).first()
+        delivered = sender(*args)
+        if notification:
+            notification.status = "sent" if delivered else "failed"
+            notification.sent_at = datetime.utcnow() if delivered else None
+            db.commit()
+    finally:
+        db.close()
+
+
+class InAppNotificationObserver(AttendanceObserver):
+    def update(self, event, db, background_tasks):
+        _record(db, event.member.user, event, "in_app", event.member_message())
+
+
+class EmailNotificationObserver(AttendanceObserver):
+    def update(self, event, db, background_tasks):
+        user = event.member.user
+        if not user.attendance_alerts:
+            return
+        notification = _record(db, user, event, "email", event.member_message(), status="pending")
+        background_tasks.add_task(_deliver, notification.id, send_email, user.email, event.subject(), f"<p>{event.member_message()}</p>")
+
+
+class SmsNotificationObserver(AttendanceObserver):
+    def update(self, event, db, background_tasks):
+        user = event.member.user
+        if event.type == ATTENDANCE_MARKED or not (user.attendance_alerts and user.sms_opt_in and user.phone):
+            return
+        notification = _record(db, user, event, "sms", event.member_message(), status="pending")
+        background_tasks.add_task(_deliver, notification.id, send_sms, user.phone, event.member_message())
+
+
+class TrainerAlertObserver(AttendanceObserver):
+    def update(self, event, db, background_tasks):
+        trainer = event.member.assigned_trainer
+        if event.type == ATTENDANCE_MARKED or not trainer or not trainer.user:
+            return
+        _record(db, trainer.user, event, "in_app", event.trainer_message())
+
+
+class AttendancePublisher:
+    def __init__(self) -> None:
+        self._observers: List[AttendanceObserver] = []
+
+    def subscribe(self, observer: AttendanceObserver) -> None:
+        if observer not in self._observers:
+            self._observers.append(observer)
+
+    def unsubscribe(self, observer: AttendanceObserver) -> None:
+        self._observers.remove(observer)
+
+    def notify(self, event: AttendanceEvent, db: Session, background_tasks: BackgroundTasks) -> None:
+        for observer in self._observers:
+            observer.update(event, db, background_tasks)
+        db.commit()
+
+
+attendance_publisher = AttendancePublisher()
+for _observer in (InAppNotificationObserver(), EmailNotificationObserver(), SmsNotificationObserver(), TrainerAlertObserver()):
+    attendance_publisher.subscribe(_observer)
+
+
+def calculate_streak(db: Session, member_id: int) -> dict:
+    records = (
+        db.query(Attendance)
+        .filter(Attendance.member_id == member_id)
+        .order_by(Attendance.marked_at.desc())
+        .all()
+    )
+    if not records:
+        return {"streak": 0, "total_attended": 0}
+
+    dates = sorted(set(r.marked_at.date() for r in records), reverse=True)
+    streak = 1
+    for i in range(1, len(dates)):
+        if (dates[i - 1] - dates[i]).days == 1:
+            streak += 1
+        else:
+            break
+    return {"streak": streak, "total_attended": len(records)}
+
+
+def publish_attendance_marked(db: Session, background_tasks: BackgroundTasks, member: Member, cls: Class) -> None:
+    attendance_publisher.notify(AttendanceEvent(ATTENDANCE_MARKED, member, cls), db, background_tasks)
+
+    today_start = datetime.combine(datetime.utcnow().date(), datetime.min.time())
+    first_today = db.query(Attendance).filter(
+        Attendance.member_id == member.id,
+        Attendance.marked_at >= today_start,
+    ).count() == 1
+    streak = calculate_streak(db, member.id)["streak"]
+    if first_today and streak in STREAK_MILESTONES:
+        attendance_publisher.notify(AttendanceEvent(STREAK_MILESTONE, member, cls, streak=streak), db, background_tasks)
+
+
+def publish_class_missed(db: Session, background_tasks: BackgroundTasks, member: Member, cls: Class) -> None:
+    attendance_publisher.notify(AttendanceEvent(CLASS_MISSED, member, cls), db, background_tasks)

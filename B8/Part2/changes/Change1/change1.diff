diff --git a/backend/app/services/workout_recommendation.py b/backend/app/services/workout_recommendation.py
new file mode 100644
--- /dev/null
+++ b/backend/app/services/workout_recommendation.py
@@ -0,0 +1,136 @@
+from abc import ABC, abstractmethod
+from typing import Dict, List, Optional
+
+DEFAULT_GOAL = "General Fitness"
+
+DIFFICULTY_SET_ADJUSTMENT = {"Beginner": -1, "Intermediate": 0, "Advanced": 1}
+
+
+class WorkoutRecommendationStrategy(ABC):
+    goal: str
+
+    @abstractmethod
+    def base_exercises(self) -> List[Dict]:
+        ...
+
+    def recommend(self, difficulty: str = "Intermediate") -> List[Dict]:
+        adjustment = DIFFICULTY_SET_ADJUSTMENT.get(difficulty, 0)
+        exercises = []
+        for exercise in self.base_exercises():
+            item = {"duration_seconds": None, **exercise}
+            item["sets"] = max(1, item["sets"] + adjustment)
+            exercises.append(item)
+        return exercises
+
+
+class GeneralFitnessStrategy(WorkoutRecommendationStrategy):
+    goal = "General Fitness"
+
+    def base_exercises(self) -> List[Dict]:
+        return [
+            {"name": "Jumping Jacks", "sets": 3, "reps": 20},
+            {"name": "Bodyweight Squats", "sets": 3, "reps": 15},
+            {"name": "Push-ups", "sets": 3, "reps": 10},
+            {"name": "Plank", "sets": 3, "reps": 1, "duration_seconds": 30},
+        ]
+
+
+class WeightLossStrategy(WorkoutRecommendationStrategy):
+    goal = "Weight Loss"
+
+    def base_exercises(self) -> List[Dict]:
+        return [
+            {"name": "Jumping Jacks", "sets": 3, "reps": 30},
+            {"name": "Mountain Climbers", "sets": 3, "reps": 20},
+            {"name": "High Knees", "sets": 3, "reps": 30},
+            {"name": "Burpees", "sets": 3, "reps": 10},
+        ]
+
+
+class MuscleBuildingStrategy(WorkoutRecommendationStrategy):
+    goal = "Muscle Building"
+
+    def base_exercises(self) -> List[Dict]:
+        return [
+            {"name": "Push-ups", "sets": 4, "reps": 12},
+            {"name": "Dumbbell Curls", "sets": 3, "reps": 12},
+            {"name": "Squats", "sets": 4, "reps": 12},
+            {"name": "Dumbbell Rows", "sets": 3, "reps": 12},
+        ]
+
+
+class StrengthTrainingStrategy(WorkoutRecommendationStrategy):
+    goal = "Strength Training"
+
+    def base_exercises(self) -> List[Dict]:
+        return [
+            {"name": "Squats", "sets": 4, "reps": 8},
+            {"name": "Push-ups", "sets": 4, "reps": 10},
+            {"name": "Lunges", "sets": 3, "reps": 10},
+            {"name": "Plank", "sets": 3, "reps": 1, "duration_seconds": 40},
+        ]
+
+
+class EnduranceStrategy(WorkoutRecommendationStrategy):
+    goal = "Endurance"
+
+    def base_exercises(self) -> List[Dict]:
+        return [
+            {"name": "Jogging", "sets": 3, "reps": 1, "duration_seconds": 300},
+            {"name": "Jump Rope", "sets": 3, "reps": 50},
+            {"name": "Cycling", "sets": 3, "reps": 1, "duration_seconds": 300},
+            {"name": "Mountain Climbers", "sets": 3, "reps": 20},
+        ]
+
+
+class FlexibilityStrategy(WorkoutRecommendationStrategy):
+    goal = "Flexibility"
+
+    def base_exercises(self) -> List[Dict]:
+        return [
+            {"name": "Standing Forward Bend", "sets": 3, "reps": 1, "duration_seconds": 30},
+            {"name": "Cat-Cow Stretch", "sets": 3, "reps": 10},
+            {"name": "Child Pose", "sets": 3, "reps": 1, "duration_seconds": 30},
+            {"name": "Hamstring Stretch", "sets": 3, "reps": 1, "duration_seconds": 30},
+        ]
+
+
+class WorkoutRecommendationFactory:
+    _strategies: Dict[str, WorkoutRecommendationStrategy] = {
+        strategy.goal: strategy
+        for strategy in (
+            GeneralFitnessStrategy(),
+            WeightLossStrategy(),
+            MuscleBuildingStrategy(),
+            StrengthTrainingStrategy(),
+            EnduranceStrategy(),
+            FlexibilityStrategy(),
+        )
+    }
+
+    @classmethod
+    def get_strategy(cls, goal: Optional[str]) -> WorkoutRecommendationStrategy:
+        return cls._strategies.get(goal or DEFAULT_GOAL, cls._strategies[DEFAULT_GOAL])
+
+    @classmethod
+    def available_goals(cls) -> List[str]:
+        return list(cls._strategies.keys())
+
+
+GOAL_KEYWORDS = [
+    ("Weight Loss", ("lose", "loss", "fat", "slim", "weight")),
+    ("Muscle Building", ("muscle", "bulk", "mass", "tone", "hypertrophy")),
+    ("Strength Training", ("strength", "strong", "power", "lift")),
+    ("Endurance", ("endurance", "stamina", "cardio", "run", "marathon", "cycling")),
+    ("Flexibility", ("flexib", "yoga", "stretch", "mobility")),
+]
+
+
+def infer_goal_from_text(fitness_goals: Optional[str]) -> Optional[str]:
+    if not fitness_goals:
+        return None
+    text = fitness_goals.lower()
+    for goal, keywords in GOAL_KEYWORDS:
+        if any(keyword in text for keyword in keywords):
+            return goal
+    return None

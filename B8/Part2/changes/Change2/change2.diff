+from fastapi import APIRouter, Depends, HTTPException, BackgroundTasks
+from sqlalchemy.orm import Session
+from typing import List
+
+from ..database import get_db
+from ..models import User, Member, Trainer, TrainerAssignment, UserRole
+from ..schemas.assignments import (
+    AssignmentPolicyResponse, AssignTrainerRequest, AutoAssignRequest,
+    TrainerAssignmentResponse, AutoAssignResult

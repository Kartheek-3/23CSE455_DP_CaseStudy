new file mode 100644
--- /dev/null
+++ b/backend/app/services/trainer_assignment.py
@@ -0,0 +1,152 @@
+from abc import ABC, abstractmethod
+from datetime import datetime
+from typing import Dict, List, Optional
+
+from sqlalchemy import func
+from sqlalchemy.orm import Session
+
+from ..models import Member, Trainer, TrainerAssignment, User
+from .workout_recommendation import infer_goal_from_text
+
+DEFAULT_MAX_CLIENTS = 10
+
+SPECIALIZATION_KEYWORDS = {
+    "Weight Loss": ("weight", "fat", "hiit", "cardio", "nutrition"),
+    "Muscle Building": ("muscle", "bodybuilding", "hypertrophy", "strength"),
+    "Strength Training": ("strength", "powerlifting", "crossfit", "weightlifting"),
+    "Endurance": ("endurance", "cardio", "running", "cycling", "hiit"),
+    "Flexibility": ("yoga", "pilates", "flexibility", "mobility", "stretch"),
+}
+
+
+class AssignmentError(Exception):
+    pass
+
+
+class TrainerAssignmentPolicy(ABC):
+    name: str
+    label: str
+    description: str
+
+    @abstractmethod
+    def select_trainer(self, member: Member, candidates: List[Trainer], loads: Dict[int, int]) -> Optional[Trainer]:
+        ...
+
+
+class LeastLoadedPolicy(TrainerAssignmentPolicy):
+    name = "least_loaded"
+    label = "Least loaded"
+    description = "Assign the trainer with the fewest active clients; ties go to the higher-rated trainer."
+
+    def select_trainer(self, member, candidates, loads):
+        if not candidates:
+            return None
+        return min(candidates, key=lambda t: (loads.get(t.id, 0), -(t.rating or 0)))
+
+
+class HighestRatedPolicy(TrainerAssignmentPolicy):
+    name = "highest_rated"
+    label = "Highest rated"
+    description = "Assign the trainer with the best member rating; ties go to the less loaded trainer."
+
+    def select_trainer(self, member, candidates, loads):
+        if not candidates:
+            return None
+        return min(candidates, key=lambda t: (-(t.rating or 0), loads.get(t.id, 0)))
+
+
+class SpecializationMatchPolicy(TrainerAssignmentPolicy):
+    name = "specialization_match"
+    label = "Specialization match"
+    description = "Match the member's fitness goals to a trainer specialization; falls back to the least loaded trainer."
+
+    def select_trainer(self, member, candidates, loads):
+        goal = infer_goal_from_text(member.fitness_goals)
+        keywords = SPECIALIZATION_KEYWORDS.get(goal, ())
+        matching = [t for t in candidates if any(k in (t.specialization or "").lower() for k in keywords)]
+        return LeastLoadedPolicy().select_trainer(member, matching or candidates, loads)
+
+
+class TrainerAssignmentPolicyFactory:
+    _policies: Dict[str, TrainerAssignmentPolicy] = {
+        policy.name: policy
+        for policy in (SpecializationMatchPolicy(), LeastLoadedPolicy(), HighestRatedPolicy())
+    }
+
+    @classmethod
+    def get_policy(cls, name: str) -> TrainerAssignmentPolicy:
+        policy = cls._policies.get(name)
+        if not policy:
+            raise AssignmentError(f"Unknown assignment policy: {name}")
+        return policy
+
+    @classmethod
+    def available_policies(cls) -> List[dict]:
+        return [{"name": p.name, "label": p.label, "description": p.description} for p in cls._policies.values()]
+
+
+def trainer_loads(db: Session) -> Dict[int, int]:
+    rows = (
+        db.query(Member.assigned_trainer_id, func.count(Member.id))
+        .join(User, Member.user_id == User.id)
+        .filter(Member.assigned_trainer_id.isnot(None), User.is_active == True)
+        .group_by(Member.assigned_trainer_id)
+        .all()
+    )
+    return {trainer_id: count for trainer_id, count in rows}
+
+
+def capacity_of(trainer: Trainer) -> int:
+    return trainer.max_clients or DEFAULT_MAX_CLIENTS
+
+
+def eligible_trainers(db: Session, loads: Dict[int, int], exclude_trainer_id: Optional[int] = None) -> List[Trainer]:
+    trainers = db.query(Trainer).join(User).filter(User.is_active == True).all()
+    return [
+        t for t in trainers
+        if loads.get(t.id, 0) < capacity_of(t) and t.id != exclude_trainer_id
+    ]
+
+
+def assign_trainer(
+    db: Session,
+    member: Member,
+    assigned_by: User,
+    policy_name: Optional[str] = None,
+    trainer_id: Optional[int] = None,
+) -> TrainerAssignment:
+    loads = trainer_loads(db)
+    candidates = eligible_trainers(db, loads, exclude_trainer_id=member.assigned_trainer_id)
+
+    if trainer_id is not None:
+        trainer = next((t for t in candidates if t.id == trainer_id), None)
+        if not trainer:
+            raise AssignmentError("Trainer is inactive, already assigned to this member, or at full capacity")
+        policy_used = "manual"
+    else:
+        policy = TrainerAssignmentPolicyFactory.get_policy(policy_name or SpecializationMatchPolicy.name)
+        trainer = policy.select_trainer(member, candidates, loads)
+        if not trainer:
+            raise AssignmentError("No eligible trainer has free capacity")
+        policy_used = policy.name
+
+    end_active_assignment(db, member)
+    member.assigned_trainer_id = trainer.id
+    assignment = TrainerAssignment(
+        member_id=member.id,
+        trainer_id=trainer.id,
+        policy=policy_used,
+        assigned_by=assigned_by.id,
+    )
+    db.add(assignment)
+    db.commit()
+    db.refresh(assignment)
+    return assignment
+
+
+def end_active_assignment(db: Session, member: Member) -> None:
+    db.query(TrainerAssignment).filter(
+        TrainerAssignment.member_id == member.id,
+        TrainerAssignment.is_active == True,
+    ).update({"is_active": False, "ended_at": datetime.utcnow()})
+    member.assigned_trainer_id = None

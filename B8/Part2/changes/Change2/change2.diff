+)
+from ..utils.notifications import send_email
+
+router = APIRouter()
+
+
+def _build_assignment_response(assignment: TrainerAssignment) -> dict:
+    return {
+        "id": assignment.id,
+        "member_id": assignment.member_id,
+        "member_name": assignment.member.user.full_name if assignment.member and assignment.member.user else None,
+        "trainer_id": assignment.trainer_id,
+        "trainer_name": assignment.trainer.user.full_name if assignment.trainer and assignment.trainer.user else None,
+        "policy": assignment.policy,
+        "assigned_at": assignment.assigned_at,
+        "ended_at": assignment.ended_at,
+        "is_active": assignment.is_active,
+    }
+
+
+def _notify_assignment(background_tasks: BackgroundTasks, assignment: TrainerAssignment) -> None:
+    member_user = assignment.member.user
+    trainer_user = assignment.trainer.user
+    background_tasks.add_task(
+        send_email,
+        member_user.email,
+        "Your Personal Trainer",
+        f"<p>Hi {member_user.full_name}, <strong>{trainer_user.full_name}</strong> is now your personal trainer.</p>",
+    )
+    background_tasks.add_task(
+        send_email,
+        trainer_user.email,
+        "New Client Assigned",
+        f"<p>Hi {trainer_user.full_name}, <strong>{member_user.full_name}</strong> has been assigned to you as a client.</p>",
+    )
+
+
+def _get_member(db: Session, member_id: int) -> Member:
+    member = db.query(Member).filter(Member.id == member_id).first()
+    if not member:
+        raise HTTPException(status_code=404, detail="Member not found")
+    return member
+
+
+@router.get("/policies", response_model=List[AssignmentPolicyResponse])
+def list_policies(current_user: User = Depends(get_current_admin)):
+    return TrainerAssignmentPolicyFactory.available_policies()
+
+
+@router.post("/members/{member_id}", response_model=TrainerAssignmentResponse)
+def assign_member(
+    member_id: int,
+    request: AssignTrainerRequest,
+    background_tasks: BackgroundTasks,
+    db: Session = Depends(get_db),
+    current_user: User = Depends(get_current_admin),
+):
+    member = _get_member(db, member_id)
+    try:
+        assignment = assign_trainer(db, member, current_user, policy_name=request.policy, trainer_id=request.trainer_id)
+    except AssignmentError as e:
+        raise HTTPException(status_code=400, detail=str(e))
+    _notify_assignment(background_tasks, assignment)
+    return _build_assignment_response(assignment)
+
+
+@router.delete("/members/{member_id}")
+def unassign_member(
+    member_id: int,
+    db: Session = Depends(get_db),
+    current_user: User = Depends(get_current_admin),
+):
+    member = _get_member(db, member_id)
+    if not member.assigned_trainer_id:
+        raise HTTPException(status_code=400, detail="Member has no assigned trainer")
+    end_active_assignment(db, member)
+    db.commit()
+    return {"message": "Trainer unassigned"}
+
+
+@router.post("/auto-assign", response_model=AutoAssignResult)
+def auto_assign(
+    request: AutoAssignRequest,
+    background_tasks: BackgroundTasks,
+    db: Session = Depends(get_db),
+    current_user: User = Depends(get_current_admin),
+):
+    try:
+        TrainerAssignmentPolicyFactory.get_policy(request.policy)
+    except AssignmentError as e:
+        raise HTTPException(status_code=400, detail=str(e))
+
+    unassigned = (
+        db.query(Member).join(User)
+        .filter(Member.assigned_trainer_id.is_(None), User.is_active == True)
+        .all()
+    )
+    created, skipped = [], 0
+    for member in unassigned:
+        try:
+            assignment = assign_trainer(db, member, current_user, policy_name=request.policy)
+        except AssignmentError:
+            skipped += 1
+            continue
+        _notify_assignment(background_tasks, assignment)
+        created.append(_build_assignment_response(assignment))
+    return {"assigned": len(created), "skipped": skipped, "assignments": created}
+
+
+@router.get("/members/{member_id}/history", response_model=List[TrainerAssignmentResponse])
+def assignment_history(
+    member_id: int,
+    db: Session = Depends(get_db),
+    current_user: User = Depends(get_current_admin),
+):
+    history = (
+        db.query(TrainerAssignment)
+        .filter(TrainerAssignment.member_id == member_id)
+        .order_by(TrainerAssignment.assigned_at.desc())
+        .all()
+    )
+    return [_build_assignment_response(a) for a in history]
+
+
+@router.get("/my-clients", response_model=List[MemberResponse])
+def my_clients(
+    db: Session = Depends(get_db),
+    current_user: User = Depends(get_current_trainer),
+):
+    if current_user.role == UserRole.ADMIN:
+        members = db.query(Member).join(User).filter(User.is_active == True).all()
+        return [_build_member_response(m) for m in members]
+    trainer = db.query(Trainer).filter(Trainer.user_id == current_user.id).first()
+    if not trainer:
+        raise HTTPException(status_code=404, detail="Trainer profile not found")
+    return [_build_member_response(m) for m in trainer.clients if m.user and m.user.is_active]

+"""Observer pattern for job publication events.
+
+The subject owns a list of observers and notifies them after a job is saved.
+Observers implement update(job). The default observer logs the event; additional
+observers (email, in-app alerts, queue publishing) can be subscribed later.
+"""
+from __future__ import annotations
+
+import logging
+from typing import Protocol
+
+logger = logging.getLogger(__name__)
+
+
+class JobObserver(Protocol):
+    """Contract for objects interested in newly created jobs."""
+
+    def update(self, job) -> None:
+        """Handle a newly created job."""
+
+
+class JobCreatedLoggingObserver:
+    """A safe default observer that records job-created events in application logs."""
+
+    def update(self, job) -> None:
+        logger.info(
+            "Job created: id=%s title=%r category_id=%s",
+            job.pk,
+            job.title,
+            getattr(job, "category_id", None),
+        )
+
+
+class JobCreatedSubject:
+    """Subject that allows observers to subscribe, unsubscribe, and receive events."""
+
+    def __init__(self, observers=None):
+        self._observers = list(observers or [])
+
+    def subscribe(self, observer: JobObserver) -> None:
+        if observer not in self._observers:
+            self._observers.append(observer)
+
+    def unsubscribe(self, observer: JobObserver) -> None:
+        if observer in self._observers:
+            self._observers.remove(observer)
+
+    def notify(self, job) -> None:
+        # Snapshot avoids changes to subscriptions affecting the current dispatch.
+        for observer in tuple(self._observers):
+            try:
+                observer.update(job)
+            except Exception:
+                # A notification observer must not break successful job creation.
+                logger.exception(
+                    "Job-created observer %r failed for job id=%s",
+                    observer,
+                    getattr(job, "pk", None),
+                )
+
+
+job_created_subject = JobCreatedSubject([JobCreatedLoggingObserver()])

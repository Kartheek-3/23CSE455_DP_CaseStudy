+import unittest
+from unittest.mock import Mock
+
+from jobsapp.observers import JobCreatedSubject
+
+
+class JobCreatedSubjectTests(unittest.TestCase):
+    def setUp(self):
+        self.job = Mock(pk=7, title="Backend Engineer", category_id=3)
+
+    def test_notify_calls_each_subscribed_observer(self):
+        first, second = Mock(), Mock()
+        subject = JobCreatedSubject([first, second])
+
+        subject.notify(self.job)
+
+        first.update.assert_called_once_with(self.job)
+        second.update.assert_called_once_with(self.job)
+
+    def test_subscribe_adds_observer(self):
+        observer = Mock()
+        subject = JobCreatedSubject()
+        subject.subscribe(observer)
+
+        subject.notify(self.job)
+
+        observer.update.assert_called_once_with(self.job)
+
+    def test_duplicate_subscription_is_ignored(self):
+        observer = Mock()
+        subject = JobCreatedSubject()
+        subject.subscribe(observer)
+        subject.subscribe(observer)
+
+        subject.notify(self.job)
+
+        observer.update.assert_called_once_with(self.job)
+
+    def test_unsubscribe_stops_notifications(self):
+        observer = Mock()
+        subject = JobCreatedSubject([observer])
+        subject.unsubscribe(observer)
+
+        subject.notify(self.job)
+
+        observer.update.assert_not_called()
+
+    def test_unsubscribing_unknown_observer_is_safe(self):
+        subject = JobCreatedSubject()
+        subject.unsubscribe(Mock())
+        subject.notify(self.job)
+
+    def test_observer_failure_does_not_block_other_observers(self):
+        failing, healthy = Mock(), Mock()
+        failing.update.side_effect = RuntimeError("notification failed")
+        subject = JobCreatedSubject([failing, healthy])
+
+        with self.assertLogs("jobsapp.observers", level="ERROR"):
+            subject.notify(self.job)
+
+        healthy.update.assert_called_once_with(self.job)
+
+
+if __name__ == "__main__":
+    unittest.main()

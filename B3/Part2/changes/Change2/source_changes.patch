+
+from types import SimpleNamespace
+
+from django.test import SimpleTestCase
+
+from jobsapp.graphql.permissions import IsRecruiter
+
+
+class TestIsRecruiterPermission(SimpleTestCase):
+    def setUp(self):
+        self.permission = IsRecruiter()
+
+    def make_request(self, authenticated, role=None):
+        user = SimpleNamespace(
+            is_authenticated=authenticated,
+            role=role,
+        )
+        return SimpleNamespace(user=user)
+
+    def test_authenticated_recruiter_is_allowed(self):
+        request = self.make_request(True, "recruiter")
+
+        self.assertTrue(self.permission.has_permission(request))
+
+    def test_employer_is_denied(self):
+        request = self.make_request(True, "employer")
+
+        self.assertFalse(self.permission.has_permission(request))
+
+    def test_employee_is_denied(self):
+        request = self.make_request(True, "employee")
+
+        self.assertFalse(self.permission.has_permission(request))
+
+    def test_anonymous_user_is_denied(self):
+        request = self.make_request(False, "recruiter")
+
+        self.assertFalse(self.permission.has_permission(request))
+
+    def test_missing_user_is_denied(self):
+        request = SimpleNamespace(user=None)
+
+        self.assertFalse(self.permission.has_permission(request))

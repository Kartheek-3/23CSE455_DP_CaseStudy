@@ -0,0 +1,70 @@
+
+import json
+
+from django.test import TestCase, Client
+from django.urls import reverse
+
+from tests.factories.user_factory import UserFactory
+from tests.factories.job_factory import JobFactory
+
+
+class RecruiterJobsQueryTests(TestCase):
+    def setUp(self):
+        self.client = Client()
+        self.endpoint = "/graphql/"
+
+        self.recruiter = UserFactory(role="recruiter")
+        self.employer = UserFactory(role="employer")
+
+        self.published_job = JobFactory(status="published", filled=False)
+        self.closed_job = JobFactory(status="closed", filled=False)
+        self.filled_job = JobFactory(status="published", filled=True)
+
+    def execute_query(self, query):
+        return self.client.post(
+            self.endpoint,
+            data=json.dumps({"query": query}),
+            content_type="application/json",
+        )
+
+    def test_recruiter_can_query_published_unfilled_jobs(self):
+        self.client.force_login(self.recruiter)
+
+        response = self.execute_query(
+            "{ recruiterJobs { id title status filled } }"
+        )
+
+        self.assertEqual(response.status_code, 200)
+        payload = response.json()
+        self.assertNotIn("errors", payload)
+
+        returned_ids = {
+            int(job["id"]) for job in payload["data"]["recruiterJobs"]
+        }
+        self.assertIn(self.published_job.id, returned_ids)
+        self.assertNotIn(self.closed_job.id, returned_ids)
+        self.assertNotIn(self.filled_job.id, returned_ids)
+
+    def test_employer_cannot_query_recruiter_jobs(self):
+        self.client.force_login(self.employer)
+
+        response = self.execute_query("{ recruiterJobs { id title } }")
+
+        self.assertEqual(response.status_code, 200)
+        payload = response.json()
+        self.assertIn("errors", payload)
+
+    def test_anonymous_user_cannot_query_recruiter_jobs(self):
+        response = self.execute_query("{ recruiterJobs { id title } }")
+
+        self.assertEqual(response.status_code, 200)
+        payload = response.json()
+        self.assertIn("errors", payload)
+
+    def test_existing_public_jobs_query_still_works(self):
+        response = self.execute_query("{ jobs { id title } }")
+
+        self.assertEqual(response.status_code, 200)
+        payload = response.json()
+        self.assertNotIn("errors", payload)
+        self.assertIn("jobs", payload["data"])

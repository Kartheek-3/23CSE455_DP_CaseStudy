@@ -0,0 +1,50 @@
+
+from django.test import SimpleTestCase
+
+from jobsapp.application_states import (
+    AcceptedState,
+    ApplicationStateFactory,
+    PendingState,
+    RejectedState,
+)
+
+
+class TestApplicationStates(SimpleTestCase):
+    def test_status_codes_and_labels(self):
+        expected = {
+            1: (PendingState, "Pending"),
+            2: (AcceptedState, "Accepted"),
+            3: (RejectedState, "Rejected"),
+        }
+
+        for code, (state_class, label) in expected.items():
+            with self.subTest(code=code):
+                state = ApplicationStateFactory.from_code(code)
+                self.assertIsInstance(state, state_class)
+                self.assertEqual(state.code, code)
+                self.assertEqual(state.label, label)
+
+    def test_pending_can_transition_to_accepted_or_rejected(self):
+        state = PendingState()
+
+        self.assertTrue(state.can_transition_to(AcceptedState()))
+        self.assertTrue(state.can_transition_to(RejectedState()))
+
+    def test_accepted_can_transition_to_rejected(self):
+        self.assertTrue(
+            AcceptedState().can_transition_to(RejectedState())
+        )
+        self.assertFalse(
+            AcceptedState().can_transition_to(PendingState())
+        )
+
+    def test_rejected_is_terminal(self):
+        state = RejectedState()
+
+        self.assertFalse(state.can_transition_to(PendingState()))
+        self.assertFalse(state.can_transition_to(AcceptedState()))
+        self.assertFalse(state.can_transition_to(RejectedState()))
+
+    def test_unknown_status_code_raises_error(self):
+        with self.assertRaises(ValueError):
+            ApplicationStateFactory.from_code(99)

+from abc import ABC, abstractmethod
+
+
+class ApplicationState(ABC):
+    """Interface for applicant-status behavior."""
+
+    @property
+    @abstractmethod
+    def code(self) -> int:
+        """Return the integer code stored in Applicant.status."""
+        raise NotImplementedError
+
+    @property
+    @abstractmethod
+    def label(self) -> str:
+        """Return the human-readable status."""
+        raise NotImplementedError
+
+    @abstractmethod
+    def can_transition_to(self, target: "ApplicationState") -> bool:
+        """Determine whether a transition to another state is allowed."""
+        raise NotImplementedError
+
+
+class PendingState(ApplicationState):
+    @property
+    def code(self) -> int:
+        return 1
+
+    @property
+    def label(self) -> str:
+        return "Pending"
+
+    def can_transition_to(self, target: ApplicationState) -> bool:
+        return isinstance(target, (AcceptedState, RejectedState))
+
+
+class AcceptedState(ApplicationState):
+    @property
+    def code(self) -> int:
+        return 2
+
+    @property
+    def label(self) -> str:
+        return "Accepted"
+
+    def can_transition_to(self, target: ApplicationState) -> bool:
+        return isinstance(target, RejectedState)
+
+
+class RejectedState(ApplicationState):
+    @property
+    def code(self) -> int:
+        return 3
+
+    @property
+    def label(self) -> str:
+        return "Rejected"
+
+    def can_transition_to(self, target: ApplicationState) -> bool:
+        return False
+
+
+class ApplicationStateFactory:
+    """Resolve an existing database status code to its State object."""
+
+    _states = {
+        1: PendingState,
+        2: AcceptedState,
+        3: RejectedState,
+    }
+
+    @classmethod
+    def from_code(cls, code: int) -> ApplicationState:
+        try:
+            state_class = cls._states[code]
+        except KeyError:
+            raise ValueError(f"Unknown application status code: {code}") from None
+
+        return state_class()

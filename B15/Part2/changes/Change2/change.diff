+from app.core.policy_engine import AccessContext, AccessPolicyEngine, SuperuserRule, ProjectOwnerRule, EmbargoPolicyRule, RoleBasedRule
+
+_default_engine = AccessPolicyEngine(rules=[
+    SuperuserRule(),
+    ProjectOwnerRule(),
+    EmbargoPolicyRule(),
+    RoleBasedRule(),
+])
+
+def require_access(
+    project_id: UUID,
+    db: Session = Depends(get_db),
+    current_user: models.User = Depends(get_current_approved_user),
+) -> None:
+    """FastAPI dependency: raises 403 if the policy engine denies access."""
+    ctx = AccessContext(user_id=current_user.id, user_is_superuser=current_user.is_superuser, project_id=project_id)
+    decision = _default_engine.evaluate_chain(ctx)
+    if decision.name != "ALLOW":
+        raise HTTPException(status_code=status.HTTP_403_FORBIDDEN, detail="Access denied by policy engine")

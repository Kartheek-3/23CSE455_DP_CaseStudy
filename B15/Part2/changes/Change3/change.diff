+from abc import ABC, abstractmethod
+
+class WorkflowStatusObserver(ABC):
+    @abstractmethod
+    def on_step_complete(self, step_name: str, result, context) -> None:
+        pass
+
+class JobStatusObserver(WorkflowStatusObserver):
+    """Writes step transitions to the Job record for UI display."""
+    def on_step_complete(self, step_name, result, context) -> None:
+        print(f"[Job {context.job_id}] {step_name} -> {result.value}")


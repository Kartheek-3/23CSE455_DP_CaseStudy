+"""Experiment Workflow Pipeline — Strategy (WorkflowStep) + Template Method (run) + Observer notification."""
+from abc import ABC, abstractmethod
+from dataclasses import dataclass, field
+from enum import Enum
+from typing import List, Optional
+from uuid import UUID
+
+class StepResult(Enum):
+    SUCCESS = "SUCCESS"
+    FAILURE = "FAILURE"
+    SKIPPED = "SKIPPED"
+
+@dataclass
+class WorkflowContext:
+    data_product_id: UUID
+    job_id: UUID
+    user_id: UUID
+    extra: dict = field(default_factory=dict)
+
+class WorkflowStep(ABC):
+    """Strategy interface for a single pipeline phase."""
+    @abstractmethod
+    def execute(self, context: WorkflowContext) -> StepResult:
+        pass
+
+class ValidationStep(WorkflowStep):
+    def execute(self, context: WorkflowContext) -> StepResult:
+        # verify file exists and has expected extension
+        return StepResult.SUCCESS
+
+class ProcessingStep(WorkflowStep):
+    def execute(self, context: WorkflowContext) -> StepResult:
+        # trigger rasterio/geoprocessing
+        return StepResult.SUCCESS
+
+class PolicyCheckStep(WorkflowStep):
+    def execute(self, context: WorkflowContext) -> StepResult:
+        # call AccessPolicyEngine for publication permission
+        return StepResult.SUCCESS
+
+class PublicationStep(WorkflowStep):
+    def execute(self, context: WorkflowContext) -> StepResult:
+        # generate STAC record and mark data product active
+        return StepResult.SUCCESS
+
+class ExperimentWorkflowPipeline:
+    """Template Method: defines fixed step order; Strategy: each step is interchangeable."""
+    def __init__(self, steps: List[WorkflowStep], observers: List = None):
+        self.steps = steps
+        self.observers = observers or []
+
+    def run(self, context: WorkflowContext) -> StepResult:
+        for step in self.steps:
+            result = step.execute(context)
+            for obs in self.observers:
+                obs.on_step_complete(step.__class__.__name__, result, context)
+            if result == StepResult.FAILURE:
+                return StepResult.FAILURE
+        return StepResult.SUCCESS


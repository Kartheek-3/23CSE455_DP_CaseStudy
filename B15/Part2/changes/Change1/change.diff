+from uuid import UUID
+from sqlalchemy import select, desc
+from sqlalchemy.orm import Session
+from app.crud.base import CRUDBase
+from app.models.data_product import DataProduct
+from app.models.data_product_version import DataProductVersion
+
+class CRUDDataProductVersion(CRUDBase):
+    def create_snapshot(self, db: Session, data_product_id: UUID, change_summary: str = "") -> DataProductVersion:
+        with db as session:
+            dp = session.get(DataProduct, data_product_id)
+            previous = session.scalars(
+                select(DataProductVersion)
+                .where(DataProductVersion.data_product_id == data_product_id, DataProductVersion.is_current == True)
+            ).first()
+            if previous:
+                previous.is_current = False
+            version = DataProductVersion(
+                data_product_id=data_product_id,
+                parent_version_id=previous.id if previous else None,
+                filepath=dp.filepath,
+                stac_properties=dp.stac_properties,
+                change_summary=change_summary,
+                is_current=True,
+            )
+            session.add(version)
+            session.commit()
+            session.refresh(version)
+        return version
+
+    def get_version_history(self, db: Session, data_product_id: UUID):
+        with db as session:
+            return session.scalars(
+                select(DataProductVersion)
+                .where(DataProductVersion.data_product_id == data_product_id)
+                .order_by(desc(DataProductVersion.created_at))
+            ).all()
+
+    def checkout_version(self, db: Session, version_id: UUID) -> DataProductVersion:
+        with db as session:
+            version = session.get(DataProductVersion, version_id)
+            # mark all other versions as not current
+            session.scalars(
+                select(DataProductVersion).where(DataProductVersion.data_product_id == version.data_product_id)
+            ).all()
+            for v in session.scalars(select(DataProductVersion).where(DataProductVersion.data_product_id == version.data_product_id)):
+                v.is_current = False
+            version.is_current = True
+            # sync parent DataProduct
+            dp = session.get(DataProduct, version.data_product_id)
+            dp.filepath = version.filepath
+            dp.stac_properties = version.stac_properties
+            session.commit()
+            session.refresh(version)
+        return version
+
+data_product_version = CRUDDataProductVersion(DataProductVersion)

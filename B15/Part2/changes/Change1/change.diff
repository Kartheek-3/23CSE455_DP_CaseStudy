+import uuid
+from datetime import datetime
+from typing import Optional
+from sqlalchemy import Boolean, DateTime, ForeignKey, String
+from sqlalchemy.dialects.postgresql import JSONB, UUID
+from sqlalchemy.orm import Mapped, mapped_column, relationship
+from app.db.base_class import Base
+from app.models.utils.utcnow import utcnow
+
+class DataProductVersion(Base):
+    """Immutable snapshot of a DataProduct at a point in time (Memento/Temporal Object pattern)."""
+    __tablename__ = "data_product_versions"
+
+    id: Mapped[uuid.UUID] = mapped_column(UUID(as_uuid=True), primary_key=True, default=uuid.uuid4)
+    data_product_id: Mapped[uuid.UUID] = mapped_column(UUID(as_uuid=True), ForeignKey("data_products.id", ondelete="CASCADE"), nullable=False)
+    parent_version_id: Mapped[Optional[uuid.UUID]] = mapped_column(UUID(as_uuid=True), ForeignKey("data_product_versions.id"), nullable=True)
+    filepath: Mapped[str] = mapped_column(String, nullable=False)
+    stac_properties: Mapped[Optional[dict]] = mapped_column(JSONB, nullable=True)
+    change_summary: Mapped[Optional[str]] = mapped_column(String(512), nullable=True)
+    is_current: Mapped[bool] = mapped_column(Boolean, default=False, nullable=False)
+    created_at: Mapped[datetime] = mapped_column(DateTime(timezone=True), server_default=utcnow(), nullable=False)
+
+    # self-referential parent link for DAG
+    parent = relationship("DataProductVersion", remote_side=[id], backref="children")
+    data_product = relationship("DataProduct", back_populates="versions")


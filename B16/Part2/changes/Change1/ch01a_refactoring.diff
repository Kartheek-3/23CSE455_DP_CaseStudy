+	/**
+	 * Count the identifier as a container and/or a test; an identifier of type
+	 * {@code CONTAINER_AND_TEST} is counted as both.
+	 */
+	private static void count(TestIdentifier testIdentifier, AtomicLong containers, AtomicLong tests) {
+		if (testIdentifier.isContainer()) {
+			containers.incrementAndGet();
+		}
+		if (testIdentifier.isTest()) {
+			tests.incrementAndGet();
+		}
+	}

+	/**
+	 * Property name used to set the mode of the configurable filter policy:
+	 * {@value}
+	 *
+	 * <p>Supported values:
+	 * <ul>
+	 * <li>{@code off} (default): the policy is not applied.
+	 * <li>{@code exclude}: tests matched by the policy are removed from the test plan.
+	 * <li>{@code only}: only tests matched by the policy are kept.
+	 * </ul>
+	 *
+	 * <p>A test is matched if it matches any tag expression in
+	 * {@link #FILTER_POLICY_TAGS_PROPERTY_NAME} or any pattern in
+	 * {@link #FILTER_POLICY_METHODS_PROPERTY_NAME}; at least one of the two
+	 * must be set unless the mode is {@code off}. The policy is applied after
+	 * all other post-discovery filters, so it can only narrow their result.
+	 * Invalid values make discovery fail with a message naming the parameter.
+	 *
+	 * @since 6.2
+	 */
+	@API(status = EXPERIMENTAL, since = "6.2")
+	public static final String FILTER_POLICY_MODE_PROPERTY_NAME = "junit.platform.filter.policy.mode";
+
+	/**
+	 * Property name used to supply the comma-separated
+	 * {@linkplain TagFilter tag expressions} of the filter policy: {@value}
+	 *
+	 * @since 6.2
+	 * @see #FILTER_POLICY_MODE_PROPERTY_NAME
+	 */
+	@API(status = EXPERIMENTAL, since = "6.2")
+	public static final String FILTER_POLICY_TAGS_PROPERTY_NAME = "junit.platform.filter.policy.tags";
+
+	/**
+	 * Property name used to supply the comma-separated
+	 * {@linkplain MethodFilter method name patterns} of the filter policy,
+	 * matched against fully qualified method names such as
+	 * {@code com.example.MyTests#test}: {@value}
+	 *
+	 * @since 6.2
+	 * @see #FILTER_POLICY_MODE_PROPERTY_NAME
+	 */
+	@API(status = EXPERIMENTAL, since = "6.2")
+	public static final String FILTER_POLICY_METHODS_PROPERTY_NAME = "junit.platform.filter.policy.methods";
+
 	private LauncherConstants() {
 		/* no-op */
 	}

+import { Endpoint } from '@/server/api/endpoint-base.js';
+import { AudioTranscriptService, AUDIO_TRANSCRIPT_ERRORS } from '@/core/AudioTranscriptService.js';
+
+export const meta = {
+	tags: ['audio'],
+	requireCredential: true,
+	kind: 'write:drive',
+	limit: {
+		duration: ms('1hour'),
+		max: 60,
+	},
+	res: {
+		type: 'object',

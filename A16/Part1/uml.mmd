classDiagram
  class AuthController {+register(User) User;+login(Map) Map}
  class UserRepo {<<interface>> +save(User);+findByUsername(String)}
  class User
  AuthController --> UserRepo : uses
  UserRepo --> User : persists
  class PatientController {+createPatient(Patient);+getAllPatients();+getPatientById(Long)}
  class PatientRepo {<<interface>> +save(Patient);+findById(Long)}
  class Patient
  PatientController --> PatientRepo : uses
  PatientRepo --> Patient : persists
  class AppointmentController {+createAppointmentWithRestTemplate(Appointment);+createAppointmentWithWebClient(Appointment)}
  class AppointmentRepo {<<interface>> +save(Appointment);+findById(Long)}
  class Appointment
  AppointmentController --> AppointmentRepo : uses
  AppointmentRepo --> Appointment : persists
  AppointmentController ..> PatientController : HTTP patient validation
  class JwtAuthenticationFilter {+filter(exchange, chain)}
  JwtAuthenticationFilter ..> GatewayFilterChain : continues request
  class EurekaServerApplication
  class GatewayApplication
  class AuthServiceApplication

classDiagram
  class BillingController {+createInvoice(Invoice);+pay(id)}
  class BillingService {+create(Invoice);+pay(id);+circuitState()}
  class InvoiceRepository {
    <<interface>>
    +save(Invoice)
    +findById(id)
  }
  class Invoice
  BillingController --> BillingService : delegates
  BillingService --> InvoiceRepository : persists invoice state
  InvoiceRepository --> Invoice : stores

  class PaymentProvider {
    <<interface>>
    +charge(invoiceId, amount)
  }
  class SimulatedPaymentProvider
  class HttpPaymentProvider
  class PaymentCircuitBreaker {+execute(operation);+state()}
  BillingService --> PaymentProvider : selects provider contract
  BillingService --> PaymentCircuitBreaker : guards provider call
  SimulatedPaymentProvider ..|> PaymentProvider
  HttpPaymentProvider ..|> PaymentProvider
  HttpPaymentProvider --> ExternalPaymentAPI : adapts HTTP protocol

  class NotificationClient {+send(event)}
  class NotificationController
  class NotificationService {+record(event)}
  class NotificationRepository {
    <<interface>>
    +save(Notification)
  }
  class Notification
  BillingService --> NotificationClient : best-effort payment outcome
  NotificationClient --> NotificationController : load-balanced HTTP
  NotificationController --> NotificationService : delegates
  NotificationService --> NotificationRepository : persists outcome
  NotificationRepository --> Notification : stores

  class AppointmentController
  class DoctorValidationClient
  class NotificationClientAppointment as AppointmentNotificationClient
  AppointmentController --> DoctorValidationClient : validates doctor
  AppointmentController --> AppointmentNotificationClient : best-effort appointment event
